# Dependencias e artefactos de build
node_modules/
dist/
coverage/

# Variables de entorno reales (el .env.example sí se versiona)
.env
.env.local

# Reportes de los corredores de pruebas
*.log
.vitest-cache/

# Sistema operativo y editores
.DS_Store
Thumbs.db
.idea/
.vscode/

# Material de cátedra con copyright.
# AgilePG_SPA.pdf es la "Guía Práctica de Ágil" de PMI / Agile Alliance.
# Queda fuera del repo hasta confirmar que es privado. Para incluirlo:
#   borrar la línea de abajo y ejecutar  git add -f AgilePG_SPA.pdf
AgilePG_SPA.pdf

# Salida de la demostración con analizador de paquetes: se regenera con
#   backend/unidad-1/demo/captura-http.sh
# La transcripción de una corrida real sí queda versionada en demo/sesion-ejemplo.txt
backend/unidad-1/demo/salida/
*.pcapng
*.pcap

# Clon de trabajo del repositorio ajeno que analizamos (Cas0570/Smart-Shopper).
# No se versiona: se reconstruye con
#   git clone https://github.com/Cas0570/Smart-Shopper.git "analisis/smart-shopper"
# El análisis propio sí queda versionado en analisis/*.md
analisis/smart-shopper/

# Base de datos SQLite de la unidad 2: se crea sola al arrancar el servidor
# (las pruebas usan :memory:). El esquema vive en backend/unidad-2/src/db/.
*.db
*.db-journal
